{
  "name": "@heyq02/rspack-plugin-git-revision",
  "version": "0.1.1",
  "description": "Rspack / Rsbuild plugin that emits git revision assets (VERSION, COMMITHASH, BRANCH, LASTCOMMITDATETIME).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/heyq02/rspack-plugin-git-revision",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyq02/rspack-plugin-git-revision.git"
  },
  "bugs": {
    "url": "https://github.com/heyq02/rspack-plugin-git-revision/issues"
  },
  "keywords": [
    "rspack",
    "rsbuild",
    "git",
    "revision",
    "version",
    "commithash",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib --watch",
    "test": "rs test",
    "test:parity": "rs test tests/webpack-parity.test.ts tests/fixture-integration.test.ts",
    "test:coverage": "rs test --coverage",
    "lint": "rs lint .",
    "lint:fix": "rs lint --fix .",
    "format": "rs fmt",
    "format:check": "rs fmt --check",
    "check": "rs check",
    "changelog": "changelogen",
    "changelog:sync": "changelogen gh release all",
    "prepare": "rs hooks",
    "prepublishOnly": "pnpm run build",
    "release": "changelogen --release --no-github",
    "play:rspack": "pnpm build && pnpm --dir playground/rspack build",
    "play:rsbuild": "pnpm build && pnpm --dir playground/rsbuild build"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0",
    "@rspack/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heyq02/rstack-config": "^0.0.2",
    "@rsbuild/core": "^1.6.15",
    "@rslib/core": "^1.0.0",
    "@rslint/core": "^0.9.0",
    "@rspack/core": "^1.6.8",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "^22.19.1",
    "changelogen": "^0.6.2",
    "file-loader": "^6.2.0",
    "git-revision-webpack-plugin": "^5.0.0",
    "rstack": "^0.8.3",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
